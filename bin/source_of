#!/usr/bin/env ruby
require "bundler/setup"
require "pry"
require_relative "../lib/lr_examples"

# For use in the articles, grab the location and content of a method
target = ARGV[0]

method = Pry::Method.from_str(ARGV[0])
while method.owner.is_a?(LrExamples::Memoized::Memoizer)
  method = Pry::Method(method.super_method)
end
puts method.source_file
puts method.source_line
unless method.comment.empty?
  puts method.comment
end
puts method.source
